{
  "name": "tracksmfs-connector",
  "version": "0.1.0",
  "description": "Runs inside Shadow VM. Receives head pose via WebSocket and forwards to OpenTrack via UDP. Exposes a local tuner UI on http://localhost:7777.",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node20-win-x64 --output dist/tracksmfs-connector.exe --compress GZip"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.1.0"
  },
  "pkg": {
    "assets": [
      "ui/**/*"
    ],
    "outputPath": "dist"
  }
}
